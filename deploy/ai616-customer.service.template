[Unit]
Description=AI616 Customer Instance (<customer-id>)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai
Group=ai
WorkingDirectory=/opt/ai616
EnvironmentFile=/srv/ai616/customers/<customer-id>/data/instance.env
Environment="PATH=/home/ai/miniconda3/envs/ai_compliance/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/home/ai/miniconda3/envs/ai_compliance/bin/python -m uvicorn backend.main:app --host 127.0.0.1 --port <port> --timeout-graceful-shutdown 6
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
