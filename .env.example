# AI 合规系统 - 环境配置文件方案 (.env)
# 请复制此文件为 .env 并根据实际情况修改

# 1. 大模型 API 配置
# 后端使用的 LLM API 地址 (如 Qwen 兼容接口)
LLM_API_BASE=http://192.168.66.44:8088/v1
LLM_API_KEY=empty

# 2. 向量数据库配置
# ChromaDB 向量库持久化存储目录 (绝对路径)
PERSIST_DIR="/Users/macos/Documents/ai 合规 demo/chroma_db"

# 3. 嵌入模型配置
# 中文语义向量模型名称或路径
EMBEDDING_MODEL="shibing624/text2vec-base-chinese"

# 4. 原始资料配置
# 待向量化的原始合规文档目录
DATA_DIR="/Users/macos/Documents/ai 合规 demo/城投合规资料"

# 5. OnlyOffice Document Server 配置
# OnlyOffice DS JWT 密钥（必须与 docker-compose.yml 中 ONLYOFFICE_JWT_SECRET 一致）
ONLYOFFICE_JWT_SECRET=your-onlyoffice-jwt-secret-change-in-production
