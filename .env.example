# ══════════════════════════════════════════════════════════════════════════════
# AI 合规系统 — 环境配置文件
# 使用说明：复制此文件为 .env，根据实际部署环境修改
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. 局域网服务地址（部署到其他机器时改为本机 IP）────────────────────────────
# 当前主力服务器局域网 IP，其他机器 clone 后改为自己能访问的地址
SERVER_LAN_IP=192.168.66.44

# ── 2. 大模型 LLM（本地 Qwen3.6-35B，sglang/vLLM 部署）──────────────────────
LLM_API_BASE=http://192.168.66.44:8088/v1
LLM_API_KEY=empty
# 可选：指定本地模型路径（默认 Qwen3.6-35B-A3B-FP8）
# LLM_LOCAL_MODEL=/home/ai/.cache/modelscope/hub/models/Qwen/Qwen3.6-35B-A3B-FP8

# ── 3. 本地 ASR 转写服务（Qwen3-ASR，端口 8091）─────────────────────────────
# 实时语音识别，WebSocket 协议
QWEN_ASR_URL=http://192.168.66.44:8091
# ASR 后端选择：auto(优先本地Qwen，不可用降级Fun-ASR) / qwen(仅本地) / dashscope(仅云端)
ASR_BACKEND=auto

# ── 4. 云端 ASR（阿里 DashScope Fun-ASR，可选）──────────────────────────────
DASHSCOPE_API_KEY=sk_your_dashscope_key_here

# ── 5. Whisper 本地识别（GPU 模型，跑在后端进程内）───────────────────────────
# Whisper 不是独立网络服务，它在 backend_full.py 进程内通过 GPU 加载
# 如果本机有 GPU，clone 后直接可用；如果没有 GPU，Whisper 会自动跳过
# 指定 Whisper 使用哪块 GPU（默认 1，避免与 ASR 争抢 GPU 0）
WHISPER_GPU=1

# ── 6. 向量数据库 & 嵌入模型 ────────────────────────────────────────────────
# ChromaDB 持久化目录（绝对路径，clone 后改为新机器路径）
PERSIST_DIR="/home/ai/文档/ai616/chroma_db"
EMBEDDING_MODEL="shibing624/text2vec-base-chinese"

# ── 7. 原始合规资料目录 ────────────────────────────────────────────────────
DATA_DIR="/home/ai/文档/ai616/城投合规资料"

# ── 8. 后端端口（默认 8002，一般不用改）─────────────────────────────────────
# BACKEND_PORT=8002

# ── 9. 认证 & 安全 ────────────────────────────────────────────────────────
APP_AUTH_SECRET=ai-compliance-auth-secret-key-32bytes!
# HuggingFace Token（pyannote 声纹识别模型，去 https://huggingface.co/settings/tokens 申请）
HF_TOKEN=hf_your_token_here

# ── 10. OnlyOffice（可选，文档在线编辑）─────────────────────────────────────
ONLYOFFICE_JWT_SECRET=your-secret-key-change-in-production
BACKEND_INTERNAL_HOST=host.docker.internal
