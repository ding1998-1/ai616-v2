[Unit]
Description=Meeting Paraformer Streaming ASR Service (GPU 1)
After=network.target

[Service]
Type=simple
User=ai
WorkingDirectory=/home/ai/文档/ai616
Environment=CUDA_VISIBLE_DEVICES=1
ExecStart=/home/ai/miniconda3/envs/funasr-sensevoice/bin/python /home/ai/文档/ai616/backend/asr_online_server.py --host 127.0.0.1 --port 8091 --device cuda:0
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
